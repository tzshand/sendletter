# Stripe API Keys (live or test)
STRIPE_SECRET_KEY=sk_live_... or sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... or pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...

# Database
# In production this is auto-injected by Canner and points at the tenant
# Postgres through PgBouncer. Set it explicitly for local development.
DATABASE_URL=postgresql://user:password@host:6432/dbname

# Auth
JWT_SECRET=your-random-secret-at-least-32-chars

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Billing cron — sent by the Canner scheduled job as the x-cron-key header
CRON_SECRET=your-random-cron-secret

# Canner Auth (passkeys)
# APP_ID / ISSUER / JWKS_URL are auto-injected when the auth app is attached to
# the Canner project. The publishable key must ALSO be set with the
# NEXT_PUBLIC_ prefix, since auto-injection provides it unprefixed and Next.js
# will not expose an unprefixed variable to the browser.
CANNER_AUTH_APP_ID=...
CANNER_AUTH_ISSUER=https://auth.canner.app/apps/...
CANNER_AUTH_JWKS_URL=https://auth.canner.app/apps/.../.well-known/jwks.json
CANNER_AUTH_SECRET_KEY=cnr_auth_sk_...
NEXT_PUBLIC_CANNER_AUTH_PUBLISHABLE_KEY=cnr_auth_pk_...
